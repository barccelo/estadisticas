{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "club-deportivo-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-22",
  "keep_vars": true,
  "secrets": {
    "required": ["PIN_PEPPER", "SESSION_SECRET", "BOOTSTRAP_SECRET"]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://barccelo.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "club-deportivo-db",
      "database_id": "a3074782-a9bd-4db6-9f90-16e658eda43c"
    }
  ]
}
