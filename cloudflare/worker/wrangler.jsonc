{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cd",
  "main": "src/index.js",
  "compatibility_date": "2026-09-22",
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "../..",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://barccelo.github.io,https://cd.losrobles.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "club-deportivo-db",
      "database_id": "a3074782-a9bd-4db6-9f90-16e658eda43c"
    }
  ]
}
